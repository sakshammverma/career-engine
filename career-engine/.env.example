# Groq API key -- get one free at https://console.groq.com/keys
# Replace the placeholder below with your real key (starts with "gsk_").
# Without a real key the mentor runs in offline mode: deterministic answers
# built from the student's dashboard, no LLM call.
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the model (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
